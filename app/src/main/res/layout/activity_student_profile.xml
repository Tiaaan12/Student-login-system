<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3EFE6"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#172C45"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="34dp"
            android:paddingBottom="36dp"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="S T U D E N T   P O R T A L"
                android:textColor="#C6A56C"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />

            <ImageView
                android:id="@+id/imgStudent"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_marginTop="26dp"
                android:background="@drawable/profile_image_background"
                android:clipToOutline="true"
                android:contentDescription="Student profile photo"
                android:scaleType="centerCrop"
                android:src="@drawable/student_photo" />

            <TextView
                android:id="@+id/tvStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Christian Devera"
                android:textColor="#FAF9F6"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="STUDENT NO. 2024-1005820"
                android:textColor="#D6B879"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <View
                android:layout_width="42dp"
                android:layout_height="2dp"
                android:layout_marginTop="22dp"
                android:background="#C6A56C" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="STUDENT PROFILE"
                android:textColor="#D5DCE4"
                android:textSize="12sp"
                android:letterSpacing="0.15" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:paddingTop="30dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01  /  PERSONAL INFORMATION"
                android:textColor="#A18350"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#D9D0C1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Last Name"
                android:textColor="#827763"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Devera"
                android:textColor="#172C45"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="First Name"
                android:textColor="#827763"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Christian"
                android:textColor="#172C45"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Middle Name"
                android:textColor="#827763"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvMiddleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Viaje"
                android:textColor="#172C45"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Academic information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:text="02  /  ACADEMIC INFORMATION"
                android:textColor="#A18350"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:background="#D9D0C1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Program"
                android:textColor="#827763"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="BSCS - Machine Learning"
                android:textColor="#172C45"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="Year Level"
                android:textColor="#827763"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvYearLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="3rd Year"
                android:textColor="#172C45"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Logout -->
            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="38dp"
                android:backgroundTint="#172C45"
                android:text="LOG OUT"
                android:textColor="#E2C58F"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="ACADEMIC SERVICES  •  STUDENT PORTAL"
                android:textColor="#A49A89"
                android:textSize="10sp"
                android:letterSpacing="0.06" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>